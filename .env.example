# Required: token from @BotFather
TELEGRAM_BOT_TOKEN=replace_me

# Optional: polling/request tuning for Telegram runtime.
# These defaults are good for a single local instance.
TELEGRAM_CONNECTION_POOL_SIZE=16
TELEGRAM_POOL_TIMEOUT_SECONDS=5.0
TELEGRAM_MAX_CONCURRENT_UPDATES=8
TELEGRAM_DROP_PENDING_UPDATES=true

# Optional: single root for relocatable Cub data/config.
# Defaults to ~/.cub
CUB_HOME=~/.cub

# Optional: explicit directories for advanced/multi-instance setups.
# Leave empty to use:
# - CUB_STATE_DIR = $CUB_HOME/state
# - CUB_MIND_DIR = $CUB_HOME/mind
# - CUB_WORK_ROOT = $CUB_HOME/work
CUB_STATE_DIR=
CUB_MIND_DIR=
CUB_WORK_ROOT=

# Optional: message rendering mode for Telegram responses.
# plain -> send raw text
# markdown -> convert markdown-ish text to Telegram HTML formatting
TELEGRAM_RENDER_MODE=markdown

# Optional: comma-separated Telegram user IDs allowed to use the bot.
# Leave empty to allow anyone who can message the bot.
ALLOWED_USER_IDS=

# Optional: path for local database file.
# Leave empty to default to $CUB_STATE_DIR/assistant.db.
ASSISTANT_DB_PATH=

# Optional: working directory used for delegated Claude CLI tasks.
# Leave empty to default to $CUB_WORK_ROOT.
WORKSPACE_DIR=

# Optional: Claude command and args.
CLAUDE_COMMAND=claude
CLAUDE_ARGS=--dangerously-skip-permissions --verbose --output-format stream-json

# Optional: smart front assistant provider for quick direct replies.
# none | anthropic | openrouter | claude_cli
FRONT_ASSISTANT_PROVIDER=claude_cli

# Model for front assistant. Examples:
# - Anthropic direct: claude-3-5-haiku-latest
# - OpenRouter: anthropic/claude-3.5-haiku
# - Claude CLI: haiku
FRONT_ASSISTANT_MODEL=haiku

# Timeout budget for front assistant decision call.
FRONT_ASSISTANT_TIMEOUT_SECONDS=4.0

# Number of recent chat messages to consider for front-assistant context.
FRONT_ASSISTANT_CONTEXT_MESSAGES=80

# Fast assistant tool mode for claude_cli:
# - none: tool-free fast replies only
# - read_only: allow quick read/summarize lookups (no writes), bounded by max turns
FRONT_ASSISTANT_TOOL_MODE=read_only

# Max Claude Code turns per fast-assistant request.
# Use 2 for read_only mode (one read step + final answer), 1 for strict no-tool mode.
FRONT_ASSISTANT_MAX_TURNS=2

# Optional when FRONT_ASSISTANT_PROVIDER=claude_cli
FRONT_CLAUDE_COMMAND=claude
FRONT_CLAUDE_ARGS=--dangerously-skip-permissions

# Required when FRONT_ASSISTANT_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com

# Required when FRONT_ASSISTANT_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional: logging verbosity.
# LOG_LEVEL controls application logs.
# HTTP_LOG_LEVEL controls noisy network client logs (httpx/httpcore).
LOG_LEVEL=INFO
HTTP_LOG_LEVEL=WARNING

# Optional: progress update cadence in seconds.
PROGRESS_UPDATE_SECONDS=8

# Optional: progress message formatter.
# plain -> deterministic compact formatting
# assistant -> uses FRONT_ASSISTANT_PROVIDER model (Haiku/OpenRouter) to rewrite updates
PROGRESS_FORMATTER=plain

# Optional: final task completion message formatter.
# plain -> basic status + recent output
# assistant -> polished markdown summary via front assistant model
TASK_RESULT_FORMATTER=assistant

# Optional: reminder polling cadence in seconds.
REMINDER_POLL_SECONDS=2
